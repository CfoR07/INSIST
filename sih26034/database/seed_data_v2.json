  "rules": [
    {
      "id": "RULE-MRP-PRESENCE",
      "rule_code": "LMPC-001",
      "category_id": "CAT-ALL",
      "field": "mrp",
      "requirement": "Mandatory Maximum Retail Price (MRP) Declaration",
      "description": "Every package shall bear the retail sale price of the package in standard INR format",
      "severity": "CRITICAL"
    },
    {
      "id": "RULE-MRP-TAX-FORMAT",
      "rule_code": "LMPC-002",
      "category_id": "CAT-ALL",
      "field": "mrp",
      "requirement": "MRP Tax Inclusivity Declaration Format",
      "description": "MRP must clearly declare inclusive of all taxes",
      "severity": "ERROR"
    },
    {
      "id": "RULE-NET-QTY-METRIC",
      "rule_code": "LMPC-003",
      "category_id": "CAT-ALL",
      "field": "net_quantity",
      "requirement": "Net Quantity Declaration in Standard Metric Units",
      "description": "Net quantity shall be declared in standard metric units (g, kg, ml, l, or number)",
      "severity": "CRITICAL"
    },
    {
      "id": "RULE-USP-DECLARATION",
      "rule_code": "LMPC-004",
      "category_id": "CAT-ALL",
      "field": "unit_sale_price",
      "requirement": "Unit Sale Price (USP) Declaration",
      "description": "Mandatory for all retail packages to declare unit sale price per g/kg/ml/litre/number",
      "severity": "ERROR"
    },
    {
      "id": "RULE-MFG-DATE",
      "rule_code": "LMPC-005",
      "category_id": "CAT-ALL",
      "field": "mfg_date",
      "requirement": "Month and Year of Manufacture / Pre-Packing",
      "description": "The month and year in which the commodity is manufactured or pre-packed must be declared",
      "severity": "ERROR"
    },
    {
      "id": "RULE-EXPIRY-FOOD",
      "rule_code": "LMPC-006",
      "category_id": "CAT-FOOD",
      "field": "expiry_date",
      "requirement": "Best Before / Expiry Date Declaration for Food Commodities",
      "description": "Perishable food packages must declare Best Before or Expiry Date",
      "severity": "CRITICAL"
    },
    {
      "id": "RULE-MFG-NAME-ADDR",
      "rule_code": "LMPC-007",
      "category_id": "CAT-ALL",
      "field": "manufacturer",
      "requirement": "Name and Complete Address of Manufacturer / Packer / Importer",
      "description": "Name and complete address of the manufacturer or packer or importer must be stated",
      "severity": "ERROR"
    },
    {
      "id": "RULE-CONSUMER-CARE",
      "rule_code": "LMPC-008",
      "category_id": "CAT-ALL",
      "field": "consumer_care",
      "requirement": "Consumer Care Details (Name, Phone, Address, Email)",
      "description": "Consumer care details with postal address, telephone number, or email address must be prominent",
      "severity": "ERROR"
    },
    {
      "id": "RULE-VEG-LOGO-FOOD",
      "rule_code": "LMPC-009",
      "category_id": "CAT-FOOD",
      "field": "veg_nonveg",
      "requirement": "Vegetarian / Non-Vegetarian Logo Declaration",
      "description": "Green dot in square for Vegetarian or Brown triangle for Non-Vegetarian food packaging",
      "severity": "ERROR"
    },
    {
      "id": "RULE-COUNTRY-ORIGIN",
      "rule_code": "LMPC-010",
      "category_id": "CAT-ALL",
      "field": "country_of_origin",
      "requirement": "Country of Origin for Imported Pre-Packed Commodities",
      "description": "For imported pre-packed products, name of the Country of Origin must be explicitly declared",
      "severity": "ERROR"
    }
  ],
